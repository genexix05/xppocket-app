    "Draw text as solid pixels, with no soft edges. This looks sharper in some games." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet Text mit festen Pixeln ohne weiche Kanten. In manchen Spielen wirkt das schärfer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el texto con píxeles sólidos, sin bordes suaves. Se ve más nítido en algunos juegos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine le texte avec des pixels pleins, sans bords adoucis. Plus net dans certains jeux."
          }
        }
      }
    },
    "Draw the game at 2x its normal size. Sharper on high-resolution screens." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet das Spiel in doppelter Größe. Schärfer auf hochauflösenden Displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el juego al doble de su tamaño normal. Más nítido en pantallas de alta resolución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine le jeu à 2x sa taille normale. Plus net sur les écrans haute résolution."
          }
        }
      }
    },
    "Draw the game at 4x its normal size. Sharpest, but harder on the battery." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet das Spiel in vierfacher Größe. Am schärfsten, belastet aber den Akku stärker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja el juego al cuádruple de su tamaño normal. Lo más nítido, pero consume más batería."
