{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is still running. Resume it from its card, or force-close the app to play a different game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ läuft noch. Setze es über die Karte fort oder beende die App zwangsweise, um ein anderes Spiel zu spielen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» sigue en ejecución. Reanúdalo desde su tarjeta o fuerza el cierre de la app para jugar a otro juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est toujours en cours. Reprenez-le depuis sa carte ou forcez la fermeture de l’app pour jouer à un autre jeu."
          }
        }
      }
    },
    "\"%@\" will close. Progress you haven't saved will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird geschlossen. Nicht gespeicherter Fortschritt geht verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se cerrará. Perderás el progreso que no hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » va se fermer. La progression non sauvegardée sera perdue."
          }
        }
      }
    },
    "%@\n\nClose %@ from the app switcher, then reopen it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBeende %@ im App-Umschalter und öffne die App erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nCierra %@ desde el selector de apps y vuelve a abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nFermez %@ depuis le sélecteur d’apps, puis rouvrez-la."
          }
        }
      }
    },
    "%@ are already in your library. Importing replaces their files with the new ones. Your saves and settings stay. You can't undo this." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind bereits in deiner Bibliothek. Beim Import werden die Dateien durch die neuen ersetzt. Deine Spielstände und Einstellungen bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya están en tu biblioteca. Al importar se reemplazan sus archivos por los nuevos. Tus partidas y ajustes se conservan. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont déjà dans votre bibliothèque. L’importation remplace leurs fichiers par les nouveaux. Vos sauvegardes et réglages sont conservés. Cette action est irréversible."
          }
        }
      }
    },
    "%@ can't read this game's own settings, so the values below start from %@'s defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann die eigenen Einstellungen dieses Spiels nicht lesen. Die Werte unten beginnen deshalb mit den Standardwerten von %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede leer los ajustes propios de este juego, así que los valores de abajo parten de los predeterminados de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas lire les réglages propres à ce jeu ; les valeurs ci-dessous partent donc des réglages par défaut de %@."
          }
        }
      }
    },
    "%@ can't run this game" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann dieses Spiel nicht ausführen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede ejecutar este juego"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas lancer ce jeu"
          }
        }
      }
    },
    "%@ closed" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde geschlossen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se cerró"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est fermé"
          }
        }
      }
    },
    "%@ comes with this layout. A game uses it when the game has no layout of its own and no profile applies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält dieses Layout. Ein Spiel verwendet es, wenn es kein eigenes Layout hat und kein Profil gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ incluye este diseño. Un juego lo usa cuando no tiene diseño propio y no se aplica ningún perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inclut cette disposition. Un jeu l’utilise quand il n’a pas de disposition propre et qu’aucun profil ne s’applique."
          }
        }
      }
    },
    "%@ comes with this layout. Games use it when nothing else applies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält dieses Layout. Spiele verwenden es, wenn sonst nichts gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ incluye este diseño. Los juegos lo usan cuando no se aplica nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ inclut cette disposition. Les jeux l’utilisent quand rien d’autre ne s’applique."
          }
        }
      }
    },
    "%@ couldn't move the saves for \"%@\" to Rescued Saves. Free up space and delete again, or delete now and lose those saves. You can't undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte die Spielstände von „%@“ nicht nach „Gerettete Spielstände“ verschieben. Schaffe Platz und lösche erneut oder lösche jetzt und verliere diese Spielstände. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no pudo mover las partidas guardadas de «%@» a Partidas rescatadas. Libera espacio y vuelve a eliminarlo, o elimínalo ahora y pierde esas partidas. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu déplacer les sauvegardes de « %@ » vers Sauvegardes récupérées. Libérez de l’espace et supprimez à nouveau, ou supprimez maintenant et perdez ces sauvegardes. Cette action est irréversible."
          }
        }
      }
    },
    "%@ deletes older logs each time you start a game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ löscht ältere Protokolle bei jedem Spielstart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ elimina los registros antiguos cada vez que inicias un juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supprime les anciens journaux à chaque lancement d’un jeu."
          }
        }
      }
    },
    "%@ didn't start" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde nicht gestartet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se inició"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne s’est pas lancé"
          }
        }
      }
    },
    "%@ FPS" : {

    },
    "%@ is already in your library. Importing replaces its files with the new ones. Your saves and settings stay. You can't undo this." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereits in deiner Bibliothek. Beim Import werden die Dateien durch die neuen ersetzt. Deine Spielstände und Einstellungen bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está en tu biblioteca. Al importar se reemplazan sus archivos por los nuevos. Tus partidas y ajustes se conservan. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà dans votre bibliothèque. L’importation remplace ses fichiers par les nouveaux. Vos sauvegardes et réglages sont conservés. Cette action est irréversible."
          }
        }
      }
    },
    "%@ is free software. You can redistribute and modify it under the terms of the GNU General Public License." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist freie Software. Du kannst sie unter den Bedingungen der GNU General Public License weitergeben und verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es software libre. Puedes redistribuirlo y modificarlo bajo los términos de la Licencia Pública General de GNU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un logiciel libre. Vous pouvez le redistribuer et le modifier selon les termes de la licence publique générale GNU."
          }
        }
      }
    },
    "%@ is still checking this game. Stopping now discards it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ prüft dieses Spiel noch. Wenn du jetzt abbrichst, wird es verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sigue comprobando este juego. Si lo detienes ahora, se descartará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vérifie encore ce jeu. L’arrêter maintenant l’annule."
          }
        }
      }
    },
