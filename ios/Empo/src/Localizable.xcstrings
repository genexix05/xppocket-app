    "You cannot edit this layout. %@ keeps it unchanged as a fallback that works for every game. To make your own version, duplicate it as a profile and edit the copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dieses Layout nicht bearbeiten. %@ behält es unverändert als Rückfallebene, die mit jedem Spiel funktioniert. Für eine eigene Version dupliziere es als Profil und bearbeite die Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes editar este diseño. %@ lo mantiene sin cambios como alternativa que funciona con cualquier juego. Para crear tu propia versión, duplícalo como perfil y edita la copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas modifier cette disposition. %@ la conserve inchangée comme solution de repli qui fonctionne avec tous les jeux. Pour créer votre version, dupliquez-la en tant que profil et modifiez la copie."
          }
        }
      }
    },
    "Your edits will create a new profile." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen erstellen ein neues Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios crearán un perfil nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications créeront un nouveau profil."
          }
        }
      }
    },
    "Your layout profile has %lld %@, so %@ used its own layout. Open Logs for details." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Layout-Profil enthält %lld %@, daher hat %@ sein eigenes Layout verwendet. Öffne die Protokolle für Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil de diseño tiene %lld %@, así que %@ usó su propio diseño. Abre los registros para ver los detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil de disposition contient %lld %@ ; %@ a donc utilisé sa propre disposition. Ouvrez les journaux pour plus de détails."
