    "Uploads every save location for this game. Download replaces local saves with the cloud copy — restart the game to load it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt alle Speicherorte dieses Spiels hoch. Beim Herunterladen werden lokale Spielstände durch die Cloud-Kopie ersetzt – starte das Spiel neu, um sie zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube todas las ubicaciones de guardado de este juego. Al descargar se reemplazan las partidas locales con la copia de la nube; reinicia el juego para cargarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie tous les emplacements de sauvegarde de ce jeu. Le téléchargement remplace les sauvegardes locales par la copie du cloud — redémarrez le jeu pour la charger."
          }
        }
      }
    },
