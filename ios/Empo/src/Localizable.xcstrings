    "Keep a lowercase index of every game file so lookups are faster. Turn it off if the game can't find its images or sounds." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen Kleinbuchstaben-Index jeder Spieldatei, damit Suchen schneller gehen. Schalte es aus, wenn das Spiel seine Bilder oder Klänge nicht findet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene un índice en minúsculas de cada archivo del juego para que las búsquedas sean más rápidas. Desactívalo si el juego no encuentra sus imágenes o sonidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve un index en minuscules de chaque fichier du jeu pour accélérer les recherches. Désactivez-le si le jeu ne trouve pas ses images ou ses sons."
          }
        }
      }
    },
