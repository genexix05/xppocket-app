    "A core runs the games in its list. %@ opens the core a game needs when you start the game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Core führt die Spiele in seiner Liste aus. %@ öffnet den Core, den ein Spiel braucht, wenn du es startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un núcleo ejecuta los juegos de su lista. %@ abre el núcleo que necesita un juego cuando lo inicias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cœur exécute les jeux de sa liste. %@ ouvre le cœur dont un jeu a besoin quand vous le lancez."
          }
        }
      }
    },
