      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XP Pocket sucht Spieler in deinem Netzwerk, damit du lokale Multiplayer-Spiele spielen kannst."
