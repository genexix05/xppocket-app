    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XP Pocket verwendet Bluetooth, damit du mit einem kabellosen Controller spielen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XP Pocket uses Bluetooth so you can play with a wireless game controller."
          }
        },
