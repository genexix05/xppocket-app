    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm ein Foto auf, um es als eigenes Artwork oder Banner für das Spiel zu verwenden."
