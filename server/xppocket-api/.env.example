# Clave para subir layouts (header: X-Admin-Key). Genera una larga y aleatoria.
XPPOCKET_ADMIN_KEY=replace-with-a-long-random-secret

# Sesiones Sign in with Apple (genera un secreto largo y aleatorio).
XPPOCKET_JWT_SECRET=replace-with-a-long-random-jwt-secret

# Bundle ID de la app iOS (audience del token de Apple).
XPPOCKET_APPLE_CLIENT_ID=app.xppocket.player
XPPOCKET_APPLE_CLIENT_ID_DEV=app.xppocket.player.dev

# Solo desarrollo: POST /v1/auth/dev (simulador / cuenta Apple gratuita).
XPPOCKET_DEV_AUTH=false

# Orígenes CORS separados por coma. * permite todo (útil en desarrollo).
XPPOCKET_CORS_ORIGINS=*
